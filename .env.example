# DVLAA 环境变量模板：复制为 .env 后按需修改；install.sh 会自动加载 .env。
# ── 控制台登录 ──
DVLAA_ADMIN_USERNAME=admin
DVLAA_ADMIN_PASSWORD=DVLAA2026+

# ── Flask 会话密钥（生产部署务必修改为随机值） ──
# SECRET_KEY=please-change-me

# ── 云端 LLM（按需填写其一；未配置时状态机题目仍可离线游玩） ──
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# HF_TOKEN=

# ── 本地模型 ──
# DVLAA_PRELOAD_LOCAL_MODEL=false
# DVLAA_TORCH_THREADS=4

# ── AWDP 模拟目标（native 容器轨；容器名经 dvlaa-net 解析） ──
# DVLAA_AWDP_NATIVE_MODE=auto
# DVLAA_AWDP_NATIVE_URL=http://dvlaa-awdp-native:5900
# DVLAA_AWDP_NATIVE_PUBLIC_PREFIX=/awdp-target
# 模拟轨回退开关：默认开启（模拟轨开箱即用）；置为 false 强制走官方真实容器轨。
# DVLAA_AWDP_NATIVE_FALLBACK=true
# DVLAA_DIFY_FIXTURE_FALLBACK=true

# ── 官方真实容器轨（integrations/upstream，可选） ──
# DVLAA_UPSTREAM_MODE=auto
# DVLAA_DIFY_MODE=native
# DVLAA_DIFY_URL=http://host.docker.internal:5800
