# DVLAA real Dify integration
# Upstream: https://github.com/langgenius/dify/tree/1.9.2/docker
# Copy this file to .env. bootstrap.sh fills CHANGE_ME_* secrets automatically.

COMPOSE_PROJECT_NAME=dvlaa-dify

# The official nginx container listens on 80; expose it locally on 5800.
EXPOSE_NGINX_PORT=5800
EXPOSE_NGINX_SSL_PORT=5443
# Dify also uses this value as the numeric remote-plugin installation port.
# Keep the upstream numeric form so the API can start; the service is not
# linked from DVLAA and should remain firewalled on production hosts.
EXPOSE_PLUGIN_DEBUGGING_PORT=5003
NGINX_PORT=80
NGINX_SSL_PORT=443
NGINX_SERVER_NAME=_
NGINX_HTTPS_ENABLED=false

# Use the public Dify URL for Console redirects and shared application links.
# Change these together when serving this stack behind a domain.
CONSOLE_WEB_URL=http://127.0.0.1:5800
APP_WEB_URL=http://127.0.0.1:5800
CONSOLE_API_URL=http://127.0.0.1:5800/console/api
APP_API_URL=http://127.0.0.1:5800
SERVICE_API_URL=http://127.0.0.1:5800
FILES_URL=http://127.0.0.1:5800/files
INTERNAL_FILES_URL=

# Start only the default Weaviate profile. The other upstream profiles remain
# available by changing VECTOR_STORE/COMPOSE_PROFILES when needed.
VECTOR_STORE=weaviate
COMPOSE_PROFILES=weaviate

# Public origin used by provision.py and the DVLAA native-target adapter.
DIFY_URL=http://127.0.0.1:5800

# Dify application/database secrets. Never commit the generated .env file.
SECRET_KEY=CHANGE_ME_SECRET_KEY
DB_USERNAME=postgres
DB_DATABASE=dify
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=dify
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
CELERY_BROKER_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/1
SANDBOX_API_KEY=CHANGE_ME_SANDBOX_API_KEY
PLUGIN_DAEMON_KEY=CHANGE_ME_PLUGIN_DAEMON_KEY
PLUGIN_DIFY_INNER_API_KEY=CHANGE_ME_PLUGIN_DIFY_INNER_API_KEY

# OpenAI-compatible base URL used by Dify's built-in OpenAI provider.
# Credentials are entered in Dify Settings -> Model Provider and are stored
# in Dify's database, not in the DVLAA repository.
OPENAI_API_BASE=https://api.openai.com/v1

# Optional operator hints for a SiliconFlow/Qwen or another compatible model.
# bootstrap.sh prints the selected model name, but Dify still requires the
# provider key to be configured in its native UI/API after first login.
DVLAA_MODEL_PROVIDER=OpenAI-API-compatible
DVLAA_MODEL_API_BASE=https://api.siliconflow.cn/v1
DVLAA_MODEL_API_KEY=
DVLAA_MODEL_NAME=Qwen/Qwen3-8B

# Native AWDP02 provisioning. This administrator is local to the isolated
# Dify stack; replace the password before exposing the service externally.
DIFY_AUTO_PROVISION=true
DIFY_ADMIN_EMAIL=admin@dvlaa.local
DIFY_ADMIN_NAME=DVLAA Administrator
DIFY_ADMIN_PASSWORD=DVLAA2026+
DIFY_APP_NAME=DVLAA AWDP02 Migration Assistant

# Optional provider bootstrap. The bootstrap recognizes the official
# OpenAI-API-compatible plugin label and maps it to its marketplace slug. The
# plugin must be installed in the native Console before `provision` runs.
# Provider plugins use different credential schemas; use the JSON object below
# for a provider that is not OpenAI-compatible.
DIFY_MODEL_PROVIDER=
DIFY_MODEL_API_BASE=
DIFY_MODEL_API_KEY=
DIFY_MODEL_CREDENTIALS_JSON=

# Keep optional services disabled unless explicitly requested.
NGINX_ENABLE_CERTBOT_CHALLENGE=false
ENABLE_OTEL=false

# Values are unused unless the optional certbot profile is enabled, but keeping
# them explicit makes `docker compose config` warning-free.
CERTBOT_EMAIL=
CERTBOT_DOMAIN=
CERTBOT_OPTIONS=
